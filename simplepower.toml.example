# Copyable example only; this root file is not active repository configuration.
# Copy the keys you want into a supported configuration layer when needed.

use_subagent = false
# Quick verification remains mandatory. true runs it in the main agent;
# false dispatches the FAST quick-verifier subagent and uses scratch refs.
skip_quick_verifier = true
# Deprecated compatibility/no-op in the normal brainstorming-to-implementation
# chain. Still recognized and strictly validated for existing configs.
skip_final_review = false
subagent_model = "gpt-5.6-luna-xhigh"
# Deprecated compatibility/no-op in the normal chain. Still recognized and
# strictly validated, and still used as the fallback for final_review_model
# compatibility resolution.
review_model = "gpt-5.6-sol-high"
best_model = "gpt-5.6-sol-high"
normal_model = "gpt-5.6-luna-max"
fast_model = "gpt-5.3-codex-spark-xhigh"

# Optional active single-pass plan reviewer. Leave commented to keep the
# self-review-only planning flow. A non-empty SIMPLEPOWER_PLAN_REVIEW_MODEL can
# also activate and supply this model.
# plan_review_model = "gpt-5.6-luna-max"

# Deprecated compatibility/no-op in the normal chain. Optional legacy
# final-review model; absent still means use review_model for compatibility.
final_review_model = "gpt-5.6-sol-high"

# Deprecated compatibility/no-op in the normal chain. Optional legacy read-only
# second plan reviewer; there is no model-2 environment override.
review_model2 = "gpt-5.6-luna-max"
# Remove review_model2, or set it equal to review_model, for the single-reviewer
# compatibility resolution result.
